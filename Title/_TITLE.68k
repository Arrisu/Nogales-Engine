; ---------------------------------------------------------------------------
; TITLE Screen (And level select) Main Program 
; ---------------------------------------------------------------------------

titleSelection  = $FFFFFE68 
selectCntr      = $FFFFFFD0 
unkselCntr      = $FFFFFFD1 
selectCntr2     = $FFFFFFD2 
unkselCntr2     = $FFFFFFD3
cheatCnt        = $FFFFFFF4

GM_TITLE:
        bsr.w   PalFadeOut
        move    #$2700,sr   

        move.w  displayMode.w,d0      ; Disable display 
        andi.b  #$BF,d0 
        move.w  d0,VDPCTRL

        ; -------------------------------------------------------------------
        ; This sets the H32 display mode, but was likely originally H40.
        ; Jantei is H32 most of the time, so this is probably consistency.
        ; Change $8C00 here to $8C81 for H40, for TTS
        ; -------------------------------------------------------------------

        lea     (VDPCTRL).l,a6
        move.w  #$8004,(a6)                     ; 8-colour mode
        move.w  #$8200+($C000>>10),(a6)       ; set foreground nametable address
        move.w  #$8400+($E000>>13),(a6)       ; set background nametable address
        move.w  #$9001,(a6)                     ; 64-cell hscroll size
        move.w  #$9200,(a6)                     ; window vertical position
        move.w  #$8B03,(a6)
        move.w  #$8720,(a6)                     ; set background colour (palette line 2, entry 0)

        bsr.w   InitScreen

        lea     WORKRAM,a1
        moveq   #0,d0
        move.w  #$3BFF,d1
.ClearWk:
        move.l  d0,(a1)+
        dbf     d1,.ClearWk

        ; -------------------------------------------------------------------
        ; This function was added in Jantei, and does not exist in S1
        ; Most of the time, objects get cleared manually with a loop
        ; Function is appended to the end of this code
        ; -------------------------------------------------------------------

        bsr.w   ClearObjects

        ; -------------------------------------------------------------------
        ; Here is where the actual art data would get loaded
        ; In Jantei, it appears they replaced the layers such as that:
        ; - Ring -> Main text
        ; - Banner -> Large character
        ; The tilemap input sizes are also different.
        ; -------------------------------------------------------------------

        VDPCMD  move.l,$4000,VRAM,WRITE,d0   ; Set VRAM write address
        lea     ArtNem_TitleBanner,a0                  
        bsr.w   NemDec

        move.l  #$60400001,VDPCTRL
        lea     ArtNem_TitleSonic,a0 ; load Sonic title screen patterns
        bsr.w   NemDec


        ; Load layer B

        lea     MapScr_TITLE,a1
        VDPCMD  move.l,$E280,VRAM,WRITE,d0   ; Set VRAM write address
        moveq   #21,d1
        moveq   #17,d2
        bsr.w   DrawTileMap

        ; Load layer A

        lea     MapScr_TITLE,a1
        VDPCMD  move.l,$C206,VRAM,WRITE,d0   ; Set VRAM write address
        moveq   #21,d1
        moveq   #17,d2
        bsr.w   DrawTileMap

        ; This next code is the smoking gun:
        ; - The text data is loaded exactly the same as in our prototype.
        ; - The palette ID and BGM ID for the music played on the title matches.

        lea     VDPDATA,a6
        move.l  #$70000003,4(a6)        ; Set VRAM write to addr. $F000
        lea     ArtUnc_Text,a5          ; Get text art address
        move.w  #$27F,d1                ; Set amount of data to load

.LoadText:
        move.w  (a5)+,(a6)
        dbf     d1,.LoadText


        moveq   #1,d0
        bsr.w   PalQueueForFade
        move.b  #BGMNO_TITLE,d0           ; ...or $8A
        jsr     QueueSoundB


        ; Now here's where things deviate a bit and get strange.
        ; Jantei Monogatari has a menu system and a sound test implemented
        ; The code has a noticeably different style, and was likely
        ; custom for Jantei itself.
        ; the clr instructions below are for the menu input code.

        move.b  #OBJNO_TITLESONIC,objSlot01.w ; load big Sonic object
        move.w  #2580,genericTimer.w  ; run title screen for 2580 frames
        ;clr.w   selectCntr.w
        ;clr.w   selectCntr2.w
        ;clr.b   titleSelection.w
        ;clr.w   cheatCnt.w

        move.w  displayMode.w,d0      ; Enable display
        ori.b   #$40,d0
        move.w  d0,VDPCTRL
        bsr.w   PalFadeIn

.WaitInput:
                move.b  #4,vblankCmd.w
                jsr     VSync
                jsr     RunObjects
                jsr     DrawObjects
                tst.w   genericTimer.w
                beq.w   Title_TimerOut
                andi.b  #$80,joypadPress.w
                beq.w   .WaitInput
;               move.b  #1,(v_objslot0+obFrame).w
;               addq.b  #2,(v_objslot0+obRoutine).w
;               move.b  #8,(v_objslot1).w
Title_Loop:
                move.b  #$E0,d0
                jsr     QueueSoundB
                clr.b   ($FFFFC344).w           ; unknowns
                clr.w   ($FFFFC212).w
                clr.b   ($FFFFFFE0).w
                clr.b   ($FFFFFFE1).w
                move.b  #GMNO_LEVEL,(gamemode).w
               ; bsr.w   ClearObjects            ; added
                rts

Title_TimerOut:
                move.b  #GMNO_LOGO,(gamemode).w
                rts
; ---------------------------------------------------------------------------
; Jantei ported function to clear objects
; Direct drop-in port. This only clears necessary objects for Jantei
; ---------------------------------------------------------------------------

ClearObjects:
                lea     OBJECTRAM.w,a1
                moveq   #0,d0
                move.w  #$180-1,d1

.ClrObjs:
                move.l  d0,(a1)+
                dbf     d1,.ClrObjs
                rts