	dc.b   8, 95
	dc.b   0, 47
	dc.b   8, 44
	dc.b   0, 33
	dc.b   8,  3
	dc.b  40, 48
	dc.b   8,  8
	dc.b   0, 46
	dc.b   8, 21
	dc.b   0, 15
	dc.b   8, 70
	dc.b   0, 26
	dc.b   8,255
	dc.b   8,202
	dc.b   0,  0
	dc.b   0,  0
	dc.b   0,  0
	dc.b   0,  0
	dc.b   0,  0