DebugArtLoad:
	VDPCMD  move.l,$9E00,VRAM,WRITE,VDPCTRL

	lea     ArtUnc_Text,a0
	move.w  #$9F,d1
	bsr.s   .DebugLoadLoop

	lea     ArtUnc_Text+$220,a0
	move.w  #$16F,d1
	bsr.s   .DebugLoadLoop

	VDPCMD  move.l,$D000,VRAM,WRITE,VDPCTRL

	lea     ArtUnc_Text,a0
	move.w  #$9F,d1
	bsr.s   .DebugLoadLoop

	lea     ArtUnc_Text+$220,a0
	move.w  #$16F,d1

.DebugLoadLoop:
	move.w  (a0)+,VDPDATA
	dbf     d1,.DebugLoadLoop
	rts

; ---------------------------------------------------------------------------

.ColorConv:
	moveq   #0,d0
	move.b  (a0)+,d0
	ror.w   #1,d0
	lsr.b   #3,d0
	rol.w   #1,d0
	move.b  .ColorConvTbl(pc,d0.w),d2
	lsl.w   #8,d2
	moveq   #0,d0
	move.b  (a0)+,d0
	ror.w   #1,d0
	lsr.b   #3,d0
	rol.w   #1,d0
	move.b  .ColorConvTbl(pc,d0.w),d2
	move.w  d2,VDPDATA
	dbf     d1,.DebugLoadLoop ; fractured
	rts

; ---------------------------------------------------------------------------

.ColorConvTbl: 
	dc.b   0
	dc.b   6
	dc.b $60
	dc.b $66

; ---------------------------------------------------------------------------
; Calculate window plane positions for a wavy effect in HBLANK
; ---------------------------------------------------------------------------

CalcWaterWaves:
	lea     globalBuffer.w,a0
	move.w  waterCnt.w,d2
	move.w  #$9100,d3       ; Set window plane register
	move.w  #256-1,d7

.Loop:
	move.w  d2,d0
	bsr.w   CalcSinCos
	asr.w   #4,d0
	bpl.s   .SkipNegative  ; Filter negative values
	moveq   #0,d0

.SkipNegative:
	andi.w  #$1F,d0
	move.b  d0,d3
	move.w  d3,(a0)+
	addq.w  #2,d2
	dbf     d7,.Loop
	addq.w  #2,waterCnt.w
	rts


; ---------------------------------------------------------------------------
; Set Water Line for HBLANK firing
; This is horribly hacky, but I really can't be bothered right now.
; ---------------------------------------------------------------------------


SetHblankLine:
		rts
		btst    #0,(joypad).w
		beq.s   .Decrement
		addq.w  #1,(cameraZPosY).w
		tst.b   (hblankLine+1).w
		beq.s   .Decrement
		subq.b  #1,(hblankLine+1).w

.Decrement:
		btst    #1,(joypad).w
		beq.s   .Exit
		subq.w  #1,(cameraZPosY).w
		cmpi.b  #224-1,(hblankLine+1).w
		beq.s   .Exit
		addq.b  #1,(hblankLine+1).w

.Exit:
		rts

; ---------------------------------------------------------------------------
; Demo routines
; ---------------------------------------------------------------------------

RunDemo:
	tst.w	demo.w
	bne.s	.InDemo
	rts

; ---------------------------------------------------------------------------
; Demo recorder code, uses proprietary development hardware
; Data is written past the CARTRIDGE memory space at 0x800000
; ---------------------------------------------------------------------------

	lea	$800000,a1
	move.w	demoAddr.w,d0
	adda.w	d0,a1
	move.b	joypad.w,d0
	cmp.b	(a1),d0
	bne.s	.InputChanged
	addq.b	#1,1(a1)		; Count how long it's held
	cmpi.b	#$FF,1(a1)
	beq.s	.InputChanged
	rts

.InputChanged:
	move.b	d0,2(a1)
	move.b	#0,3(a1)
	addq.w	#2,demoAddr.w
	andi.w	#$3FF,demoAddr.w
	rts

; ---------------------------------------------------------------------------
; Demo playback code
; ---------------------------------------------------------------------------

.InDemo:
	lea	DemoData,a1		; Hardcoded reference here
	move.w	demoAddr.w,d0
	adda.w	d0,a1
	move.b	(a1),d0
	lea   	joypad.w,a0
	move.b	d0,d1
	move.b	(a0),d2
	eor.b 	d2,d0
	move.b	d1,(a0)+
	and.b 	d1,d0
	move.b	d0,(a0)+
	subq.b	#1,demoHeldTime.w
	bcc.s 	.Exit
	move.b	3(a1),demoHeldTime.w
	addq.w	#2,demoAddr.w

.Exit:
	rts

; ---------------------------------------------------------------------------
; Demo input table
; This is leftover in our prototype, unreferenced, right after the index
; So here, I just removed the index and made it directly reference these.
; That's probably how this was.
; ---------------------------------------------------------------------------

