


GM_LEVEL:                               
	bsr.w   ClearArtListQueue
	moveq   #0,d0
	move.b  zone.w,d0
	lsl.w   #4,d0
	lea     LevelHeaders,a2
	lea     (a2,d0.w),a2
	moveq   #0,d0
	move.b  (a2),d0
	bsr.w   LoadArtList
	bsr.w   PalFadeOut
	bsr.w   InitScreen
	lea     VDPCTRL,a6
	move.w  #$8B03,(a6)
	move.w  #$8230,(a6)
	move.w  #$8407,(a6)
	move.w  #$857C,(a6)
	move.w  #0,hblankWaterFlag.w
	move.w  #$8AAF,hblankLine.w
	move.w  #$8004,(a6)
	move.w  #$8720,(a6)
	lea     OBJECTRAM.w,a1
	moveq   #0,d0
	move.w  #((OBJSZ*96)/4)-1,d1

.ClearObjects:                         
	move.l  d0,(a1)+
	dbf     d1,.ClearObjects
	lea     cameraAPosX.w,a1
	moveq   #0,d0
	move.w  #$40-1,d1

.ClearCams:                            
	move.l  d0,(a1)+
	dbf     d1,.ClearCams
;	moveq   #3,d0
;	bsr.w   PalLoad
	moveq   #0,d0
	move.b  zone.w,d0

.WaitUntilDone:                        
	move.b  #VBCMD_LVLSTART,vblankCmd.w
	bsr.w   VSync
	bsr.w   GetObjects
	bsr.w   RunObjects
	bsr.w   DrawObjects
	bsr.w   ProcessArtLoading
	tst.l   decompQueue.w
	bne.s   .WaitUntilDone
	moveq   #3,d0
	bsr.w   PalQueueForFade
	bsr.w   CameraInit
	bsr.w   CameraScroll
	bsr.w   ProcessLevelHeader
	bsr.w   DrawCamsInit
	
	; this is really gross lol

	move.l  #LvlCol_GreenHill,collisionPtr.w

	move.b  #OBJNO_PLAYER,objSlot00.w    
;	move.b  #$21,(objSlot01).w

; DEV DEV DEV DEV DEV DEV DEV DEV DEV DEV DEV DEV DEV DEV DEV 

	; SACBLRDU

	btst    #6,joypad.w
	beq.s   .NoDebug
	move.b  #1,debug.w
	move.b  #OBJNO_PLAYTEST,objSlot00.w 
;	bsr.w   DebugSetupOld
	bra.s	.SkipDemoSet

.NoDebug:
	btst    #4,joypad.w
	beq.s   .SkipDemoSet
	move.b  #1,demo.w

.SkipDemoSet:
	btst	#5,joypad.w
	beq.s	.SkipManualCam
	move.b	#1,cameraManual.w
	move.b  #0,objSlot00.w 

.SkipManualCam:

; DEV DEV DEV DEV DEV DEV DEV DEV DEV DEV DEV DEV DEV DEV DEV 
	move.w  #0,joypadMirr.w
	move.w  #0,joypad.w
	bsr.w   GetObjects
	bsr.w   RunObjects                        
	bsr.w   DrawObjects

	lea     DemoData,a1
	move.b  1(a1),demoHeldTime.w
	subq.b  #1,demoHeldTime.w
	move.w  #1200,genericTimer.w


	move.b  #VBCMD_LEVEL,vblankCmd.w
	bsr.w   VSync
	move.w  #$8000+%00010100,VDPCTRL
	bsr.w   PalFadeIn
	bsr.w   DebugArtLoad

LevelLoop:                              
	bsr.w   PauseGame
;	bsr.w	DebugReportInfo
	move.b  #VBCMD_LEVEL,vblankCmd.w
	bsr.w   VSync
	addq.w  #1,frameCnt.w
	bsr.w   SetHblankLine
	bsr.w   RunDemo
	move.w  joypad.w,joypadMirr.w

	bsr.w   GetObjects
	bsr.w   RunObjects                        
	bsr.w   CameraScroll
	
	bsr.w   DrawObjects
	bsr.w   ProcessArtLoading

	tst.w	genericTimer.w
	bne.s	LevelLoop
	move.b	#0,gamemode.w
	rts

.DemoFadeInit:
	tst.w   restart.w
	bne.s   .NotDone
	tst.w   genericTimer.w
	beq.s   .NotDone
	cmpi.b  #GMNO_DEMO,gamemode.w
	beq.w   LevelLoop
	move.b  #GMNO_LOGO,gamemode.w
	rts
.NotDone:
	cmpi.b  #GMNO_DEMO,gamemode.w
	bne.s   .NotDemo
	move.b  #GMNO_LOGO,gamemode.w

.NotDemo:
	move.w  #$3C,genericTimer.w
	move.w  #$3F,palFadeArgs.w

.DemoFadeLoop:
	move.b  #VBCMD_LEVEL,vblankCmd.w
	bsr.w	VSync
	bsr.w	RunDemo
	bsr.w	RunObjects
	bsr.w	DrawObjects
	bsr.w	GetObjects
	subq.w  #1,demoHalfFade.w
	bpl.s   .Skip
	move.w  #2,demoHalfFade.w
	bsr.w   PalFadeOut.DoFadeCalc
.Skip:
	tst.w	genericTimer.w
	bne.s	.DemoFadeLoop
	rts

; ---------------------------------------------------------------------------
; Debugger report
; ---------------------------------------------------------------------------

DBUGSTARTSLOT = objSlot01
OBJWORD = OBJSZ*4

DebugReportInfo:
	tst.b	debug.w
	bne.s	.Go
	rts
.Go
	lea	objSlot00,a0		; v_player i think idk safety
	lea     DBUGSTARTSLOT.w,a1
	move.w  obj.X(a0),d0
	bsr.w   UpdateWordObjs
	lea     DBUGSTARTSLOT+OBJWORD*1.w,a1
	move.w  obj.Y(a0),d0
	bsr.w   UpdateWordObjs

	lea	cameraAPosX,a0	
	lea     DBUGSTARTSLOT+OBJWORD*2,a1
	moveq	#8-1,d1
.camloop:
	move.w	(a0)+,d0
	bsr.w   UpdateWordObjs
	adda.w	#2,a0
	lea	OBJSZ*4(a1),a1
	dbf	d1,.camloop
	
	move.w	hblankLine,d0
	bsr.w	UpdateWordObjs
	lea	OBJSZ*4(a1),a1
	move.w	spriteCount,d0
	bsr.w	UpdateWordObjs
	lea	OBJSZ*4(a1),a1
	move.w	demoAddr,d0
;	bsr.w	UpdateWordObjs

; ---------------------------------------------------------------------------

UpdateWordObjs:
	swap    d0
	rol.l   #4,d0
	andi.b  #$F,d0
	move.b  d0,(OBJSZ*0)+obj.Frame(a1)
	rol.l   #4,d0
	andi.b  #$F,d0
	move.b  d0,(OBJSZ*1)+obj.Frame(a1)
	rol.l   #4,d0
	andi.b  #$F,d0
	move.b  d0,(OBJSZ*2)+obj.Frame(a1)
	rol.l   #4,d0
	andi.b  #$F,d0
	move.b  d0,(OBJSZ*3)+obj.Frame(a1)
	rts

